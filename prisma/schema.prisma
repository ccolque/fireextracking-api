// Modelo de datos - FireExtracking (venta de matafuegos)
// PostgreSQL + Prisma
//
// Campos de auditoria presentes en TODAS las tablas:
//   created_by / updated_by / deleted_by : UUID del usuario que realizo la accion
//   is_deleted (default false)           : soft delete
//   deleted_at                           : fecha/hora del borrado logico
//   created_at / updated_at              : timestamps automaticos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum CapacityUnit {
  KG
  LT
}

enum ExtinguisherStatus {
  IN_STOCK
  SOLD
  CUSTOMER_OWNED
  OUT_OF_SERVICE
}

enum SaleItemType {
  NEW_SALE
  RECHARGE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum SaleStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  OTHER
}

enum ReceiptType {
  FACTURA_X
  RECIBO_PAGO_X
}

enum ReceiptStatus {
  ISSUED
  VOID
}

enum ReminderStatus {
  PENDING
  NOTIFIED
  CONTACTED
  RENEWED
  DISMISSED
}

/// Roles del sistema: Administrador y Vendedor.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(255)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permisos por modulo.
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(80)
  description String?   @db.VarChar(255)
  order       Int?
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedBy   String?   @map("deleted_by") @db.Uuid
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

/// Asignacion de permisos a roles.
model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedBy    String?   @map("deleted_by") @db.Uuid
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Usuarios con acceso al sistema.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  userName     String    @unique @map("user_name") @db.VarChar(80)
  password     String    @db.VarChar(255)
  refreshToken String?   @map("refresh_token") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(120)
  lastName     String    @map("last_name") @db.VarChar(120)
  urlPhoto     String?   @map("url_photo") @db.VarChar(500)
  roleId       String    @map("role_id") @db.Uuid
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedBy    String?   @map("deleted_by") @db.Uuid
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role               Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sales              Sale[]
  contactedReminders RenewalReminder[]

  @@map("users")
}

/// Tipos de matafuego. La unidad (kg/lts) depende del tipo.
model ExtinguisherType {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(20)
  name      String       @db.VarChar(120)
  unit      CapacityUnit
  order     Int?
  isActive  Boolean      @default(true) @map("is_active")
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid
  deletedBy String?      @map("deleted_by") @db.Uuid
  isDeleted Boolean      @default(false) @map("is_deleted")
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  capacities ExtinguisherCapacity[]

  @@map("extinguisher_types")
}

/// Capacidades por tipo; actua como lista de precios.
model ExtinguisherCapacity {
  id            String    @id @default(uuid()) @db.Uuid
  typeId        String    @map("type_id") @db.Uuid
  capacity      Decimal   @db.Decimal(6, 2)
  salePrice     Decimal?  @map("sale_price") @db.Decimal(12, 2)
  rechargePrice Decimal?  @map("recharge_price") @db.Decimal(12, 2)
  order         Int?
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  type          ExtinguisherType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  extinguishers Extinguisher[]
  saleItems     SaleItem[]

  @@unique([typeId, capacity])
  @@map("extinguisher_capacities")
}

/// Clientes.
model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  firstName String    @map("first_name") @db.VarChar(120)
  lastName  String    @map("last_name") @db.VarChar(120)
  phone     String    @db.VarChar(30)
  address   String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  notes     String?   @db.VarChar(500)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  extinguishers Extinguisher[]
  sales         Sale[]
  receipts      Receipt[]
  reminders     RenewalReminder[]

  @@index([phone])
  @@index([lastName, firstName])
  @@map("customers")
}

/// Envase fisico de un matafuego.
model Extinguisher {
  id                   String             @id @default(uuid()) @db.Uuid
  customerId           String?            @map("customer_id") @db.Uuid
  capacityId           String             @map("capacity_id") @db.Uuid
  serialNumber         String?            @map("serial_number") @db.VarChar(60)
  manufactureDate      DateTime?          @map("manufacture_date") @db.Date
  hydraulicTestDueDate DateTime?          @map("hydraulic_test_due_date") @db.Date
  brand                String?            @db.VarChar(80)
  status               ExtinguisherStatus @default(SOLD)
  notes                String?            @db.VarChar(500)
  createdBy            String?            @map("created_by") @db.Uuid
  updatedBy            String?            @map("updated_by") @db.Uuid
  deletedBy            String?            @map("deleted_by") @db.Uuid
  isDeleted            Boolean            @default(false) @map("is_deleted")
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  capacity  ExtinguisherCapacity @relation(fields: [capacityId], references: [id], onDelete: Restrict)
  saleItems SaleItem[]
  reminders RenewalReminder[]

  @@index([serialNumber])
  @@index([customerId])
  @@map("extinguishers")
}

/// Cabecera de venta.
model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  saleNumber    Int           @unique @default(autoincrement()) @map("sale_number")
  customerId    String        @map("customer_id") @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  saleDate      DateTime      @default(now()) @map("sale_date") @db.Timestamptz
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount Decimal       @default(0) @map("balance_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  status        SaleStatus    @default(ACTIVE)
  notes         String?       @db.VarChar(500)
  createdBy     String?       @map("created_by") @db.Uuid
  updatedBy     String?       @map("updated_by") @db.Uuid
  deletedBy     String?       @map("deleted_by") @db.Uuid
  isDeleted     Boolean       @default(false) @map("is_deleted")
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller   User       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items    SaleItem[]
  payments Payment[]
  receipts Receipt[]

  @@index([customerId])
  @@index([saleDate])
  @@map("sales")
}

/// Detalle de venta; un item con envase = una ficha.
model SaleItem {
  id             String       @id @default(uuid()) @db.Uuid
  saleId         String       @map("sale_id") @db.Uuid
  extinguisherId String?      @map("extinguisher_id") @db.Uuid
  capacityId     String?      @map("capacity_id") @db.Uuid
  itemType       SaleItemType @map("item_type")
  description    String       @db.VarChar(255)
  quantity       Int          @default(1)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(12, 2)
  chargeDate     DateTime?    @map("charge_date") @db.Date
  expirationDate DateTime?    @map("expiration_date") @db.Date
  tagOwnerName   String?      @map("tag_owner_name") @db.VarChar(240)
  tagAddress     String?      @map("tag_address") @db.VarChar(255)
  tagPrintedAt   DateTime?    @map("tag_printed_at") @db.Timestamptz
  tagPrintCount  Int          @default(0) @map("tag_print_count")
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedBy      String?      @map("deleted_by") @db.Uuid
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  sale         Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  extinguisher Extinguisher?         @relation(fields: [extinguisherId], references: [id], onDelete: SetNull)
  capacity     ExtinguisherCapacity? @relation(fields: [capacityId], references: [id], onDelete: SetNull)
  reminder     RenewalReminder?

  @@index([saleId])
  @@map("sale_items")
}

/// Pagos (totales o parciales).
model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz
  reference String?       @db.VarChar(120)
  notes     String?       @db.VarChar(255)
  createdBy String?       @map("created_by") @db.Uuid
  updatedBy String?       @map("updated_by") @db.Uuid
  deletedBy String?       @map("deleted_by") @db.Uuid
  isDeleted Boolean       @default(false) @map("is_deleted")
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  receipt Receipt?

  @@index([saleId])
  @@map("payments")
}

/// Comprobantes internos: Factura X y Recibo de pago.
model Receipt {
  id           String        @id @default(uuid()) @db.Uuid
  type         ReceiptType
  pointOfSale  String        @map("point_of_sale") @db.VarChar(4)
  number       String        @db.VarChar(8)
  saleId       String        @map("sale_id") @db.Uuid
  paymentId    String?       @unique @map("payment_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  issuedAt     DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  totalAmount  Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidToDate   Decimal?      @map("paid_to_date") @db.Decimal(12, 2)
  balanceAfter Decimal?      @map("balance_after") @db.Decimal(12, 2)
  pdfUrl       String?       @map("pdf_url") @db.VarChar(500)
  status       ReceiptStatus @default(ISSUED)
  createdBy    String?       @map("created_by") @db.Uuid
  updatedBy    String?       @map("updated_by") @db.Uuid
  deletedBy    String?       @map("deleted_by") @db.Uuid
  isDeleted    Boolean       @default(false) @map("is_deleted")
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([type, pointOfSale, number])
  @@index([saleId])
  @@map("receipts")
}

/// Avisos de vencimiento de carga.
model RenewalReminder {
  id                String         @id @default(uuid()) @db.Uuid
  saleItemId        String         @unique @map("sale_item_id") @db.Uuid
  extinguisherId    String         @map("extinguisher_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  dueDate           DateTime       @map("due_date") @db.Date
  notifyFrom        DateTime       @map("notify_from") @db.Date
  status            ReminderStatus @default(PENDING)
  notifiedAt        DateTime?      @map("notified_at") @db.Timestamptz
  contactedAt       DateTime?      @map("contacted_at") @db.Timestamptz
  contactedBy       String?        @map("contacted_by") @db.Uuid
  renewedSaleItemId String?        @map("renewed_sale_item_id") @db.Uuid
  notes             String?        @db.VarChar(500)
  createdBy         String?        @map("created_by") @db.Uuid
  updatedBy         String?        @map("updated_by") @db.Uuid
  deletedBy         String?        @map("deleted_by") @db.Uuid
  isDeleted         Boolean        @default(false) @map("is_deleted")
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  saleItem     SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  extinguisher Extinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactUser  User?        @relation(fields: [contactedBy], references: [id], onDelete: SetNull)

  @@index([status, notifyFrom])
  @@index([dueDate])
  @@map("renewal_reminders")
}

/// Datos del negocio y configuracion (una sola fila).
model BusinessSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  businessName          String    @map("business_name") @db.VarChar(160)
  address               String?   @db.VarChar(255)
  phone                 String?   @db.VarChar(40)
  email                 String?   @db.VarChar(255)
  logoUrl               String?   @map("logo_url") @db.VarChar(500)
  pointOfSale           String    @default("0001") @map("point_of_sale") @db.VarChar(4)
  facturaXNextNumber    Int       @default(1) @map("factura_x_next_number")
  reciboPagoXNextNumber Int       @default(1) @map("recibo_pago_x_next_number")
  renewalNoticeDays     Int       @default(3) @map("renewal_notice_days")
  tagValidityMonths     Int       @default(12) @map("tag_validity_months")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedBy             String?   @map("deleted_by") @db.Uuid
  isDeleted             Boolean   @default(false) @map("is_deleted")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("business_settings")
}
